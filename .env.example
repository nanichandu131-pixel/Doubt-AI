# --- Supabase ---
# Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Continue with Google) ---
# The Google provider must be ENABLED in the Supabase dashboard:
#   Authentication > Providers > Google > toggle ON
# Paste the OAuth Client ID and Client Secret from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs > "Web application"),
# with this Authorized redirect URI registered in Google:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Also add these Redirect URLs under Authentication > URL Configuration:
#   NEXT_PUBLIC_SITE_URL  (below)
#   http://localhost:3000/auth/callback
# There is no app code to change — these credentials live in Supabase, not .env.

# --- LLM provider selection ---
# openai | gemini | anthropic — swap providers with just this one variable.
LLM_PROVIDER=openai

# --- OpenAI (default provider) ---
# SECRET — server-only. Use a real OpenAI key here, not a Vercel AI Gateway token unless
# you intentionally want to route requests through a custom OpenAI-compatible gateway.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: only set this if you are using an OpenAI-compatible gateway such as Vercel AI Gateway.
# OPENAI_BASE_URL=

# --- Optional: only needed if LLM_PROVIDER is switched ---
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Alternative AI provider (fallback when primary hits quota / rate-limit) ---
# When set, the app automatically retries with this provider if the primary
# provider returns a 429 / quota-exceeded error. Leave empty to disable fallback.
ALTERNATIVE_AI_API_KEY=
# ALTERNATIVE_MODEL=gpt-5-mini
# ALTERNATIVE_BASE_URL=
